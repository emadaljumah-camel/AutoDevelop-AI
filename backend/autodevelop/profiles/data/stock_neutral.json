{
  "id": "stock_neutral",
  "display_name": "Stock Neutral",
  "description": "Neutral, broadly commercial stock rendering that is visibly polished, tonally defined, and never flat or unfinished.",
  "version": "1.0",
  "editing_goals": [
    "Create clean contrast with meaningful whites and blacks rather than a flat neutral rendering",
    "Produce accurate but rich color, clear subject separation, and professionally finished balanced tones",
    "Deliver immediate stock-thumbnail impact while preserving broad commercial suitability and minimal stylization"
  ],
  "cautions": [
    "Avoid weak, gray, timid, or merely corrected results",
    "Avoid dramatic or implausible contrast",
    "Avoid strong saturation",
    "Avoid obvious processing artifacts"
  ],
  "slider_ranges": {
    "Exposure2012": {"min": -0.75, "max": 0.75, "preferred": 0.0},
    "Contrast2012": {"min": -12.0, "max": 18.0, "preferred": 5.0},
    "Highlights2012": {"min": -50.0, "max": 8.0, "preferred": -20.0},
    "Shadows2012": {"min": -15.0, "max": 35.0, "preferred": 12.0},
    "Whites2012": {"min": -15.0, "max": 18.0, "preferred": 5.0},
    "Blacks2012": {"min": -18.0, "max": 12.0, "preferred": -5.0},
    "Texture": {"min": -8.0, "max": 15.0, "preferred": 3.0},
    "Clarity2012": {"min": -8.0, "max": 12.0, "preferred": 2.0},
    "Dehaze": {"min": -5.0, "max": 10.0, "preferred": 2.0},
    "Vibrance": {"min": -8.0, "max": 20.0, "preferred": 7.0},
    "Saturation": {"min": -10.0, "max": 8.0, "preferred": 0.0},
    "Temperature": {"min": 3800.0, "max": 7200.0, "preferred": 5500.0},
    "Tint": {"min": -15.0, "max": 15.0, "preferred": 0.0}
  },
  "crop_policy": {
    "allow_crop": true,
    "max_edge_crop": 0.08,
    "minimum_retained_area": 0.9,
    "minimum_confidence": 0.75,
    "require_confidence": false,
    "preserve_aspect_ratio": true
  },
  "leveling_policy": {
    "allow_leveling": true,
    "maximum_absolute_angle": 3.0,
    "guidance": [
      "Correct visible accidental rotational tilt for commercial usability",
      "Use reliable scene geometry rather than stylized or irregular references",
      "Keep a clearly intentional angle unchanged"
    ]
  },
  "denoise_policy": {
    "allow_denoise": true,
    "minimum_iso": 800,
    "minimum_amount": 0.0,
    "maximum_amount": 30.0,
    "minimum_confidence": 0.65,
    "preserve_detail": true
  }
}
