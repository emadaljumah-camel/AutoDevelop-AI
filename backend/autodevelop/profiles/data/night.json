{
  "id": "night",
  "display_name": "Night",
  "description": "Night rendering that protects bright lights, recovers shadows carefully, and permits stronger denoise.",
  "version": "1.0",
  "editing_goals": [
    "Protect artificial-light highlights",
    "Recover useful shadow detail carefully",
    "Control high-ISO noise"
  ],
