    "Contrast2012": {"min": -10.0, "max": 30.0, "preferred": 10.0},
    "Highlights2012": {"min": -80.0, "max": 0.0, "preferred": -45.0},
    "Shadows2012": {"min": -15.0, "max": 40.0, "preferred": 12.0},
    "Whites2012": {"min": -25.0, "max": 15.0, "preferred": -3.0},
    "Blacks2012": {"min": -30.0, "max": 10.0, "preferred": -10.0},
    "Texture": {"min": -10.0, "max": 18.0, "preferred": 3.0},
    "Clarity2012": {"min": -8.0, "max": 18.0, "preferred": 4.0},
    "Dehaze": {"min": -3.0, "max": 18.0, "preferred": 5.0},
    "Vibrance": {"min": -12.0, "max": 25.0, "preferred": 5.0},
    "Saturation": {"min": -15.0, "max": 10.0, "preferred": -2.0},
