{
  "id": "documentary",
  "display_name": "Documentary",
  "description": "Realistic, restrained edits that preserve atmosphere, context, and authentic color.",
  "version": "1.0",
  "editing_goals": [
    "Preserve realism and local atmosphere",
    "Protect important highlights without flattening the scene",
    "Keep available-light color and mood believable",
    "Prefer subtle corrections over dramatic transformations"
  ],
  "cautions": [
    "Avoid aggressive HDR appearance",
    "Avoid crushed shadows and excessive shadow lifting",
    "Avoid excessive saturation, clarity, texture, and dehaze",
    "Crop only for a clear composition or leveling benefit"
  ],
  "slider_ranges": {
    "Exposure2012": {"min": -0.8, "max": 0.8, "preferred": 0.0},
    "Contrast2012": {"min": -12.0, "max": 20.0, "preferred": 6.0},
    "Highlights2012": {"min": -55.0, "max": 8.0, "preferred": -22.0},
    "Shadows2012": {"min": -15.0, "max": 38.0, "preferred": 14.0},
    "Whites2012": {"min": -15.0, "max": 18.0, "preferred": 4.0},
    "Blacks2012": {"min": -18.0, "max": 12.0, "preferred": -5.0},
    "Texture": {"min": -8.0, "max": 16.0, "preferred": 4.0},
    "Clarity2012": {"min": -8.0, "max": 14.0, "preferred": 3.0},
    "Dehaze": {"min": -4.0, "max": 10.0, "preferred": 2.0},
